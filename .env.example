# 🔐 SECURITY: Backend Configuration
# Copy this to .env.local and fill in your actual values
# NEVER commit .env.local to version control!

# Backend API Configuration
NODE_ENV=development
PORT=3000

# Google Gemini API Key - KEEP STRICTLY PRIVATE!
# Get your key at: https://ai.studio/
# ⚠️ CRITICAL: NEVER expose this in frontend code or git history
# ⚠️ CRITICAL: This value is ONLY used server-side
GEMINI_API_KEY=
# App Configuration
APP_URL=http://localhost:3000

# CORS Configuration (adjust for production)
CORS_ORIGIN=http://localhost:3000

# Security: Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
